# Root env (reference only)
# API uses apps/api/.env

# Server
PORT=3000

# MongoDB
MONGO_URI="mongodb+srv://<user>:<password>@cluster0.yj0bb8w.mongodb.net/<dbName>?retryWrites=true&w=majority&appName=Cluster0"

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Seed
SEED_SUPERADMIN_EMAIL=admin@uniconnect.local
SEED_SUPERADMIN_PASSWORD=change_this_admin_password

# SMTP (emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@uniconnect.local
